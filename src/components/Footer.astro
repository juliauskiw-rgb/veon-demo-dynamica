---
import Logo from "./Logo.astro";
import FutureLink from "./FutureLink.astro";
import { TELEGRAM, PHONE_HREF, PHONE_LABEL, EMAIL, INSTAGRAM, SOON } from "../data/site";
const directions = ["Реабілітація", "Зони тіла", "Діагностика", "Пілатес", "Апаратна фізіотерапія", "Масаж"];
const centre = ["Про центр", "Команда", "Ціни", "Часті питання", "Статті", "Подарункові сертифікати"];
---
<footer class="footer" data-rec="R-009">
  <div class="container">
    <div class="footer__cols">
      <a class="footer__brand" href="#top" aria-label="Dynamica, на початок сторінки">
        <Logo markSize={48} wordHeight={20} />
      </a>
      <div>
        <h2 class="footer__h">Напрямки</h2>
        <ul>{directions.map((d) => <li><FutureLink note={SOON}>{d}</FutureLink></li>)}</ul>
      </div>
      <div>
        <h2 class="footer__h">Центр</h2>
        <ul>{centre.map((d) => <li><FutureLink note={SOON}>{d}</FutureLink></li>)}</ul>
      </div>
      <div>
        <h2 class="footer__h">Контакти</h2>
        <ul>
          <li><a href={TELEGRAM}>Telegram</a></li>
          <li><a href={PHONE_HREF} class="num">{PHONE_LABEL}</a></li>
          <li><a href={`mailto:${EMAIL}`}>{EMAIL}</a></li>
          <li><a href={INSTAGRAM} rel="noopener" target="_blank">Instagram</a></li>
          <li class="footer__addr">вул. Пирогова, 6А, Київ</li>
        </ul>
      </div>
    </div>
    <div class="footer__legal small">
      <p>© 2026 Dynamica Movement Lab, Київ</p>
      <p>ФОП Свиридов Богдан Маркович</p>
      <FutureLink note={SOON}>Політика конфіденційності</FutureLink>
    </div>
  </div>
</footer>

<style>
  .footer { padding-block: var(--s-8) var(--s-4); border-top: 1px solid var(--color-line); }
  .footer__cols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6) var(--gap); }
  .footer__brand { grid-column: 1 / -1; display: inline-flex; align-items: center; gap: .75rem; justify-self: start; min-height: 44px; }
  .footer__h { font-family: var(--font-body); font-size: var(--fs-small); font-weight: 600; color: var(--color-muted); margin-bottom: var(--s-2); }
  .footer ul { display: grid; gap: .25rem; }
  .footer li a, .footer li :global(.future-link) { display: inline-flex; align-items: center; min-height: 40px; }
  .footer li a { text-decoration: none; white-space: nowrap; }
  .footer li a:hover { text-decoration: underline; text-underline-offset: .3em; }
  .footer__addr { padding-top: .5rem; color: var(--color-muted); }
  .footer__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
    align-items: center;
    margin-top: var(--s-8);
    padding-top: var(--s-3);
    border-top: 1px solid var(--color-line);
    color: var(--color-muted);
  }
  .footer__cols > div:last-child { grid-column: 1 / -1; }
  @media (min-width: 64em) {
    .footer__cols > div:last-child { grid-column: auto; }
    .footer__cols { grid-template-columns: minmax(0, 4fr) repeat(3, minmax(0, 2.6fr)); }
    .footer__brand { grid-column: auto; align-self: start; }
  }
</style>
