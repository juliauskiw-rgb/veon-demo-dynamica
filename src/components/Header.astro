---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import Logo from "./Logo.astro";
import { nav, TELEGRAM, PHONE_HREF, PHONE_LABEL, SOON } from "../data/site";
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="#top" aria-label="Dynamica, на початок сторінки">
      <Logo markSize={36} wordHeight={20} />
    </a>

    <nav class="nav" aria-label="Розділи сторінки" data-rec="R-009">
      <ul>
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
      </ul>
    </nav>

    <div class="bar__end">
      <div class="langs" role="group" aria-label="Мова сайту">
        <span class="langs__current" aria-current="true">UK</span>
        <FutureLink note={SOON} class="langs__soon">RU</FutureLink>
        <FutureLink note={SOON} class="langs__soon">EN</FutureLink>
      </div>
      <a class="bar__phone" href={PHONE_HREF}>{PHONE_LABEL}</a>
      <a class="btn bar__cta" href={TELEGRAM} data-rec="R-002,R-005">
        <span>Записатися<span class="visually-hidden"> в Telegram</span></span>
        <Icon name="telegram" />
      </a>
      <button class="burger" type="button" popovertarget="menu" aria-label="Меню" data-rec="R-008">
        <Icon name="menu" size={24} />
      </button>
    </div>
  </div>

  <div class="progress" aria-hidden="true">
    <span class="progress__fill" data-progress-fill></span>
    <img class="progress__runner" data-progress-runner src="/img/runner-ink-48.webp" width="12" height="16" alt="" />
  </div>

  <div id="menu" class="menu" popover>
    <div class="menu__inner">
      <div class="menu__top">
        <span class="menu__title">Меню</span>
        <button class="menu__close" type="button" popovertarget="menu" popovertargetaction="hide" aria-label="Закрити меню">
          <Icon name="close" size={24} />
        </button>
      </div>
      <ul class="menu__links">
        {nav.map((n) => <li><a href={n.href} data-menu-link>{n.label}</a></li>)}
      </ul>
      <div class="menu__actions">
        <a class="btn" href={TELEGRAM} data-rec="R-002,R-005"><span>Записатися в Telegram</span><Icon name="telegram" /></a>
        <a class="link" href={PHONE_HREF}><Icon name="phone" />Подзвонити {PHONE_LABEL}</a>
      </div>
      <div class="menu__langs" role="group" aria-label="Мова сайту">
        <span aria-current="true">UK</span>
        <FutureLink note={SOON}>RU</FutureLink>
        <FutureLink note={SOON}>EN</FutureLink>
      </div>
    </div>
  </div>
</header>

<script>
  // Close the menu after an anchor is chosen (the popover itself handles Esc and outside clicks).
  const menu = document.getElementById("menu") as (HTMLElement & { hidePopover?: () => void }) | null;
  document.querySelectorAll<HTMLAnchorElement>("[data-menu-link]").forEach((a) =>
    a.addEventListener("click", () => menu?.hidePopover?.())
  );

  // Signature: the runner moves along the header track as the page scrolls (transform only).
  const fill = document.querySelector<HTMLElement>("[data-progress-fill]");
  const runner = document.querySelector<HTMLElement>("[data-progress-runner]");
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
  if (fill && runner) {
    let ticking = false;
    const update = () => {
      ticking = false;
      const max = document.documentElement.scrollHeight - window.innerHeight;
      const p = max > 0 ? Math.min(1, Math.max(0, window.scrollY / max)) : 0;
      const track = fill.parentElement?.clientWidth ?? 0;
      runner.classList.toggle("is-on", window.scrollY > 24);
      fill.style.transform = `scaleX(${p})`;
      runner.style.transform = `translateX(${Math.round(p * Math.max(0, track - 12))}px)`;
    };
    const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(update); } };
    const start = () => {
      if (reduce.matches) return;
      document.documentElement.classList.add("has-progress");
      update();
      window.addEventListener("scroll", onScroll, { passive: true });
      window.addEventListener("resize", onScroll, { passive: true });
    };
    start();
    reduce.addEventListener("change", () => {
      if (reduce.matches) {
        document.documentElement.classList.remove("has-progress");
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", onScroll);
      } else start();
    });
  }
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--color-bg);
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-2);
    height: var(--nav-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: .625rem;
    min-height: 44px;
    text-decoration: none;
    flex: none;
  }
  @media (max-width: 22.4em) { .brand :global(.logo__word) { display: none; } }
  @media (max-width: 30em) { .brand :global(.logo__word) { height: 13px; width: auto; } .brand :global(.logo__mark) { width: 32px; height: 32px; } }

  .nav { display: none; }
  .nav ul { display: flex; gap: clamp(1rem, 0.2rem + 1.4vw, 1.75rem); }
  .nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-size: .9375rem;
    font-weight: 500;
    text-decoration: none;
    background-image: linear-gradient(var(--color-text), var(--color-text));
    background-repeat: no-repeat;
    background-position: 0 calc(50% + .8em);
    background-size: 0 2px;
    transition: background-size var(--dur-fast) var(--ease-out);
  }
  .nav a:hover { background-size: 100% 2px; }

  .bar__end { display: flex; align-items: center; gap: var(--s-2); }
  .langs { display: none; align-items: center; gap: .75rem; font-size: var(--fs-small); font-weight: 500; }
  .langs__current { color: var(--color-text); text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .3em; }
  .langs :global(.langs__soon) { color: var(--color-muted); min-height: 44px; }
  .langs :global(.future-link__note) { left: auto; right: 0; }
  .bar__phone { display: none; font-size: .9375rem; font-weight: 500; text-decoration: none; font-variant-numeric: tabular-nums; min-height: 44px; align-items: center; }
  .bar__phone:hover { text-decoration: underline; text-underline-offset: .3em; }
  .bar__cta { min-height: 44px; padding: .5rem .875rem; font-size: .9375rem; }

  .burger {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -12px;
    border: 0;
    background: transparent;
    cursor: pointer;
    border-radius: var(--radius);
  }
  .burger:hover { background: var(--color-surface); }

  @media (min-width: 75em) {
    .nav { display: block; }
    .langs { display: flex; }
    .burger { display: none; }
    .bar__cta { min-height: 44px; padding: .625rem 1.125rem; }
  }
  @media (min-width: 87.5em) {
    .bar__phone { display: inline-flex; }
  }

  /* Progress track under the bar: a hairline, the filled part and the runner. */
  .progress {
    position: relative;
    height: 2px;
    background: var(--color-surface);
  }
  .progress__fill {
    position: absolute;
    inset: 0;
    background: var(--color-text);
    transform-origin: 0 50%;
    transform: scaleX(0);
    display: none;
  }
  .progress__runner {
    position: absolute;
    left: 0;
    bottom: 1px;
    width: 12px;
    height: 16px;
    display: none;
    opacity: 0;
    transition: opacity var(--dur-fast) var(--ease-out);
    will-change: transform;
  }
  .progress__runner.is-on { opacity: 1; }
  :global(.has-progress) .progress__fill,
  :global(.has-progress) .progress__runner { display: block; }

  /* Mobile menu sheet (popover: Esc and outside click close it without extra script). */
  .menu {
    position: fixed;
    inset: 0 0 auto auto;
    width: min(100%, 26rem);
    height: 100dvh;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-bg);
    color: var(--color-text);
    overflow-y: auto;
  }
  .menu::backdrop { background: color-mix(in srgb, var(--color-text) 40%, transparent); }
  .menu__inner { display: grid; gap: var(--s-4); padding: 0 var(--space) var(--s-6); }
  .menu__top { display: flex; align-items: center; justify-content: space-between; height: var(--nav-h); }
  .menu__title { font-weight: 600; }
  .menu__close { display: inline-grid; place-items: center; width: 44px; height: 44px; margin-right: -12px; border: 0; background: transparent; cursor: pointer; border-radius: var(--radius); }
  .menu__close:hover { background: var(--color-surface); }
  .menu__links { display: grid; border-top: 1px solid var(--color-line); }
  .menu__links a {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-bottom: 1px solid var(--color-line);
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.625rem;
    text-decoration: none;
  }
  .menu__links a:hover { color: var(--color-accent-ink); }
  .menu__actions { display: grid; gap: var(--s-1); }
  .menu__actions .btn { min-height: 52px; }
  .menu__langs { display: flex; gap: 1.25rem; font-weight: 500; }
  .menu__langs [aria-current] { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: .3em; }
  .menu__langs :global(.future-link) { color: var(--color-muted); }
</style>
