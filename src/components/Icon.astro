---
// Functional line icons only (Telegram, phone, map, mail, Instagram, arrow, menu). 1.5 px stroke, currentColor.
interface Props { name: "telegram" | "phone" | "map" | "mail" | "instagram" | "arrow" | "down" | "menu" | "close"; size?: number }
const { name, size = 20 } = Astro.props;
---
<svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === "telegram" && <path d="M21 4 3 11l6 2.5M21 4l-3 16-9-6.5M21 4 9 13.5V19l3-3.5" />}
  {name === "phone" && <path d="M5 4h3.5l1.5 4-2 1.5a11 11 0 0 0 6.5 6.5L16 14l4 1.5V19a1 1 0 0 1-1 1A16 16 0 0 1 4 5a1 1 0 0 1 1-1Z" />}
  {name === "map" && <><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11Z" /><circle cx="12" cy="10" r="2.25" /></>}
  {name === "mail" && <><rect x="3" y="5" width="18" height="14" rx="1.5" /><path d="m4 7 8 6 8-6" /></>}
  {name === "instagram" && <><rect x="3.5" y="3.5" width="17" height="17" rx="4.5" /><circle cx="12" cy="12" r="4" /><path d="M17.25 6.75h.01" /></>}
  {name === "arrow" && <path d="M5 12h14m-5-5 5 5-5 5" />}
  {name === "down" && <path d="M12 5v14m-5-5 5 5 5-5" />}
  {name === "menu" && <path d="M4 7h16M4 12h16M4 17h16" />}
  {name === "close" && <path d="M6 6l12 12M18 6 6 18" />}
</svg>
