---
// Solid vector logo of the client (mark + wordmark), taken from the client's own header.
// Colour comes from currentColor: graphite #15171A on light surfaces (--color-text), light on dark ones.
interface Props { markSize?: number; wordHeight?: number; class?: string }
const { markSize = 36, wordHeight = 18, class: cls } = Astro.props;
const wordWidth = Math.round((wordHeight * 1420) / 240);
