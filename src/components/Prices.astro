---
import FutureLink from "./FutureLink.astro";
import Icon from "./Icon.astro";
import { TELEGRAM, SOON } from "../data/site";
const steps = [
  { n: "1", name: "Первинний прийом фізичного терапевта", note: "90 хв, оцінка руху, пробне заняття і план", price: "2 000" },
  { n: "2", name: "Заняття з фізичним терапевтом", note: "60 хв, далі за планом", price: "1 500" },
];
const packs = [
  { name: "REHAB", note: "після операції або травми", price: "від 19 500" },
  { name: "MOVE SAFE", note: "дискомфорт у побуті", price: "від 16 100" },
  { name: "Гострий період", note: "спочатку апаратна терапія", price: "від 8 500" },
];
const single = [
  { name: "Консультація лікаря, 30 хв", price: "1 500" },
  { name: "Заняття на системі REDCORD, 60 хв", price: "1 200" },
  { name: "PHYSIO CHECK-UP", price: "3 000" },
  { name: "Тест VO₂max", price: "4 000" },
  { name: "Онлайн-заняття", price: "1 500" },
  { name: "Онлайн-консультація фізичного терапевта", price: "2 000" },
];
---
<section id="prices" class="section prices on-dark" data-rec="R-010">
  <div class="container">
    <div class="section-head">
      <h2 class="h-section">Ціни</h2>
      <p>Усе в одному місці, без прихованих платежів. Пакет рахують лише після першого прийому, під план терапевта.</p>
    </div>

    <ol class="ptrack">
      {steps.map((s) => (
        <li class="ptrack__step">
          <span class="ptrack__n num">{s.n}</span>
          <h3 class="ptrack__name">{s.name}</h3>
          <p class="ptrack__note">{s.note}</p>
          <p class="ptrack__price num">{s.price}<span> грн</span></p>
        </li>
      ))}
      <li class="ptrack__step ptrack__step--packs">
        <span class="ptrack__n num">3</span>
        <h3 class="ptrack__name">Пакет, якщо він потрібен</h3>
        <ul class="packs">
          {packs.map((p) => (
            <li>
              <span><span class="packs__name">{p.name}</span><span class="packs__note">{p.note}</span></span>
              <span class="packs__price num">{p.price}</span>
            </li>
          ))}
        </ul>
      </li>
    </ol>

    <div class="prices__more">
      <div>
        <h3 class="prices__sub">Разові послуги, грн</h3>
        <ul class="single">
          {single.map((s) => <li><span>{s.name}</span><span class="num">{s.price}</span></li>)}
        </ul>
      </div>
      <div class="prices__side">
        <p class="prices__mil">Військовим — знижка 30% на всі послуги центру.</p>
        <a class="btn btn--light" href={TELEGRAM} data-rec="R-002,R-005"><span>Записатися в Telegram</span><Icon name="telegram" /></a>
        <p><FutureLink note={SOON}>Повний прайс: фізіотерапія, масаж, абонементи</FutureLink></p>
      </div>
    </div>
  </div>
</section>

<style>
  .ptrack { position: relative; display: grid; padding-left: 24px; }
  .ptrack::before { content: ""; position: absolute; left: 0; top: 0; bottom: 0; width: var(--track); background: var(--color-on-dark); }
  .ptrack__step { position: relative; display: grid; gap: .375rem; padding: var(--s-2) 0 var(--s-4); }
  .ptrack__step::before { content: ""; position: absolute; left: -24px; top: calc(var(--s-2) + .7rem); width: 16px; height: var(--track); background: var(--color-on-dark); }
  .ptrack__n { font-weight: 600; font-size: var(--fs-small); color: var(--color-muted-on-dark); }
  .ptrack__name { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-title); line-height: 1.15; }
  .ptrack__note { color: var(--color-muted-on-dark); font-size: var(--fs-small); }
  .ptrack__price { margin-top: var(--s-1); font-weight: 600; font-size: clamp(2.5rem, 1.6rem + 3vw, 4.5rem); line-height: 1; color: var(--color-accent); letter-spacing: -0.02em; }
  .ptrack__price span { font-size: .4em; letter-spacing: 0; }

  .packs { display: grid; margin-top: var(--s-1); border-top: 1px solid var(--color-muted); }
  .packs li { display: flex; justify-content: space-between; align-items: baseline; gap: var(--s-2); padding: .75rem 0; border-bottom: 1px solid var(--color-muted); }
  .packs li > span:first-child { display: grid; }
  .packs__name { font-weight: 600; }
  .packs__note { font-size: var(--fs-small); color: var(--color-muted-on-dark); }
  .packs__price { font-weight: 600; font-size: 1.25rem; color: var(--color-accent); white-space: nowrap; }

  .prices__more { display: grid; gap: var(--s-6); margin-top: var(--s-6); }
  .prices__sub { font-family: var(--font-body); font-size: var(--fs-small); font-weight: 600; color: var(--color-muted-on-dark); margin-bottom: var(--s-2); }
  .single { border-top: 1px solid var(--color-muted); }
  .single li { display: flex; justify-content: space-between; gap: var(--s-2); padding: .75rem 0; border-bottom: 1px solid var(--color-muted); }
  .single li span:last-child { font-weight: 600; white-space: nowrap; }
  .prices__side { display: grid; gap: var(--s-3); align-content: start; justify-items: start; }
  .prices__mil { font-family: var(--font-display); font-weight: 700; font-size: var(--fs-title); line-height: 1.2; }
  .prices__side :global(.future-link) { min-height: 44px; color: var(--color-muted-on-dark); }

  @media (min-width: 64em) {
    .ptrack { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) minmax(0, 1.4fr); column-gap: var(--gap); padding-left: 0; padding-top: var(--track); }
    .ptrack::before { left: 0; right: 0; bottom: auto; width: auto; height: var(--track); }
    .ptrack__step { padding: var(--s-4) var(--s-3) 0 0; align-content: start; }
    .ptrack__step::before { left: 0; top: calc(-1 * var(--track)); width: var(--track); height: 16px; }
    .prices__more { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: var(--s-8); margin-top: var(--s-8); }
  }
</style>
