---
import FutureLink from "./FutureLink.astro";
import { teamGroups, SOON } from "../data/site";
const people = teamGroups.flatMap((g) => g.people);
---
<section id="team" class="section team" data-rec="R-006">
  <div class="container">
    <div class="section-head">
      <h2 class="h-section">Хто вас веде</h2>
      <p>Кожен веде свій напрям. Вас ставлять не до вільного вікна в розкладі, а до того, хто щодня працює саме з вашою ситуацією. Це визначає перша оцінка руху.</p>
    </div>

    <ul class="team__grid">
      {people.map((p) => (
        <li class="person">
          <img
            class="person__photo"
            src={`/img/team/${p.slug}-320.webp`}
            srcset={`/img/team/${p.slug}-320.webp 320w, /img/team/${p.slug}-600.webp 600w`}
            sizes="(min-width: 75em) 210px, (min-width: 40em) 30vw, 45vw"
            width="320"
            height="400"
            loading="lazy"
            decoding="async"
            alt={`${p.name}, ${p.role.toLowerCase()}`}
          />
          <h3 class="person__name">{p.name}</h3>
          <p class="person__role">{p.role}</p>
          <p class="person__focus">{p.focus}</p>
          <p class="person__years">{p.years}</p>
        </li>
      ))}
      <li class="team__more"><FutureLink note={SOON}>Уся команда і профілі фахівців</FutureLink></li>
    </ul>
  </div>
</section>

<style>
  .team__grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-4) var(--gap); }
  .person { display: grid; align-content: start; gap: .125rem; min-width: 0; }
  .person__photo {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    background: var(--color-surface);
    margin-bottom: var(--s-2);
  }
  .person__name { font-family: var(--font-display); font-weight: 700; font-size: 1.25rem; line-height: 1.15; }
  .person__role { font-size: var(--fs-small); font-weight: 600; }
  .person__focus { font-size: var(--fs-small); color: var(--color-muted); line-height: 1.4; }
  .person__years { font-size: var(--fs-small); color: var(--color-muted); }
  .team__more { display: flex; align-items: flex-end; padding: var(--s-2) 0; font-weight: 600; border-top: var(--track) solid var(--color-text); }
  .team__more :global(.future-link) { min-height: 44px; }

  @media (min-width: 40em) { .team__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (min-width: 75em) {
    .team__grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .person__name { font-size: 1.375rem; }
  }
</style>
